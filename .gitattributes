# Deterministic source, JSON and compiled-preview bytes on every checkout.
# Repository-scoped: do not change contributors' global core.autocrlf settings.
* text=auto eol=lf
*.glb binary
*.blend binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.zip binary
*.whl binary
*.tgz binary
# Retained scientific companions bind exact original bytes, including CRLF.
# Preserve their release/report hashes across clones and hosted builds.
/docs/validation/study-v4/** -text
/web/public/study/** -text
