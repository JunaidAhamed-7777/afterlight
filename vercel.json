{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix web ci",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/dist",
  "fluid": true,
  "functions": {
    "api/simulate.py": {
      "maxDuration": 300,
      "excludeFiles": "{web/**,docs/**,tests/**,preview/**,local-runtime/**,assets/exports/**,assets/previews/**,assets/src/**,assets/qa/**,assets/*.blend*,scripts/**,**/__pycache__/**}"
    },
    "api/cancel.py": {
      "maxDuration": 30,
      "excludeFiles": "{web/**,docs/**,tests/**,preview/**,local-runtime/**,assets/exports/**,assets/previews/**,assets/src/**,assets/qa/**,assets/*.blend*,scripts/**,**/__pycache__/**}"
    }
  },
  "headers": [
    {
      "source": "/THIRD_PARTY_NOTICES.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/replays/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/study/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/exports/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/map/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
